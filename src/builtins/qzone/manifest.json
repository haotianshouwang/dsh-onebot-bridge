{
  "id": "qq-qzone",
  "name": "QQ空间",
  "version": "1.0.0",
  "bundled": true,
  "apiVersion": 2,
  "type": "native-source",
  "entry": "src/builtins/qzone/index.js",
  "description": "主人查看可访问的空间、发文字说说和评论；默认好友可见，不自动发布或评论。",
  "dependencies": {
    "framework": ">=0.8.0"
  },
  "configVersion": 1,
  "capabilities": [
    "actions",
    "storage"
  ],
  "configSchema": {
    "publishEnabled": {
      "type": "boolean",
      "title": "允许发布说说",
      "default": true
    },
    "commentEnabled": {
      "type": "boolean",
      "title": "允许评论",
      "default": true
    },
    "visibility": {
      "type": "string",
      "title": "新说说可见范围",
      "enum": [
        "friends",
        "self",
        "public"
      ],
      "default": "friends"
    },
    "readPerHour": {
      "type": "number",
      "title": "每小时最多浏览次数",
      "description": "这是本地资源/外部接口保护，不是业务内容上限。",
      "default": 30,
      "min": 1,
      "max": 120,
      "integer": true
    },
    "dailyLimitMode": {
      "type": "string",
      "title": "每日写入限制策略",
      "enum": [
        "recommended",
        "custom",
        "unlimited"
      ],
      "default": "recommended",
      "description": "recommended 使用推荐值；custom 使用下面的自定义值；unlimited 不设业务每日上限，但仍受冷却和外部接口限制。"
    },
    "publishPerDay": {
      "type": "number",
      "title": "24小时最多发布条数（推荐/自定义）",
      "default": 3,
      "min": 1,
      "max": 100,
      "integer": true
    },
    "commentPerDay": {
      "type": "number",
      "title": "24小时最多评论条数（推荐/自定义）",
      "default": 5,
      "min": 1,
      "max": 200,
      "integer": true
    },
    "cooldownSec": {
      "type": "number",
      "title": "写入操作间隔秒数",
      "default": 60,
      "min": 30,
      "max": 3600,
      "integer": true
    },
    "allowedTargets": {
      "type": "string[]",
      "title": "可浏览和评论的QQ范围",
      "description": "留空表示主人可明确指定任意账号，但必须本来具有访问权限；不绕过空间隐私。",
      "format": "qq",
      "default": [],
      "maxItems": 100
    },
    "autoSync": {
      "type": "boolean",
      "title": "自动同步好友动态",
      "default": false,
      "description": "开启后由后台按间隔分批读取已授权好友的空间；不是前端轮询。"
    },
    "syncIntervalMinutes": {
      "type": "number",
      "title": "同步间隔（分钟）",
      "default": 15,
      "min": 2,
      "max": 1440,
      "integer": true
    },
    "syncBatchFriends": {
      "type": "number",
      "title": "每批同步好友数",
      "default": 5,
      "min": 1,
      "max": 200,
      "integer": true,
      "description": "资源保护参数；每批之间串行请求，不会并发轰炸接口。"
    },
    "postsPerFriend": {
      "type": "number",
      "title": "每位好友读取动态数",
      "default": 5,
      "min": 1,
      "max": 20,
      "integer": true
    },
    "retentionMode": {
      "type": "string",
      "title": "历史动态保留策略",
      "enum": [
        "none",
        "count",
        "days"
      ],
      "default": "none",
      "description": "none 不主动按数量删除；count 保留最近 N 条；days 按时间清理。"
    },
    "retentionCount": {
      "type": "number",
      "title": "保留动态条数",
      "default": 5000,
      "min": 1,
      "max": 100000,
      "integer": true
    },
    "retentionDays": {
      "type": "number",
      "title": "保留天数",
      "default": 365,
      "min": 1,
      "max": 3650,
      "integer": true
    }
  },
  "settings": {
    "title": "QQ空间",
    "description": "所有工具仅主人可用。评论须使用当前聊天10分钟内浏览结果的引用；发布默认好友可见，仅发文字。不会自动重试结果未知的写入。",
    "sections": [
      {
        "title": "发布与评论",
        "fields": [
          "publishEnabled",
          "commentEnabled",
          "visibility",
          "dailyLimitMode",
          "publishPerDay",
          "commentPerDay",
          "cooldownSec"
        ]
      },
      {
        "title": "读取与资源保护",
        "fields": [
          "readPerHour",
          "allowedTargets"
        ]
      },
      {
        "title": "自动同步",
        "fields": [
          "autoSync",
          "syncIntervalMinutes",
          "syncBatchFriends",
          "postsPerFriend"
        ]
      },
      {
        "title": "历史保留",
        "fields": [
          "retentionMode",
          "retentionCount",
          "retentionDays"
        ]
      }
    ]
  },
  "permissions": [
    "actions",
    "storage"
  ]
}
